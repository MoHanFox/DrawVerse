{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:drawverse:brush:dynamics-matrix:1.38",
  "title": "DrawVerse VBR 1.38 dynamics source matrix",
  "oneOf": [
    {
      "$ref": "#/$defs/matrix"
    },
    {
      "$ref": "#/$defs/preset"
    }
  ],
  "$defs": {
    "source": {
      "enum": [
        "all",
        "speed",
        "tangent",
        "distance",
        "tilt",
        "rotation",
        "direction"
      ]
    },
    "matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "size",
        "flow",
        "opacity"
      ],
      "properties": {
        "model": {
          "const": "source-matrix-v1"
        },
        "size": {
          "$ref": "#/$defs/source"
        },
        "flow": {
          "$ref": "#/$defs/source"
        },
        "opacity": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "preset": {
      "type": "object",
      "required": [
        "parameters"
      ],
      "properties": {
        "parameters": {
          "type": "object",
          "required": [
            "sourceMatrix"
          ],
          "properties": {
            "sourceMatrix": {
              "$ref": "#/$defs/matrix"
            }
          }
        }
      }
    }
  }
}
