{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:drawverse:brush:airbrush:1.29",
  "title": "DrawVerse VBR 1.29 time-interval airbrush",
  "oneOf": [
    {
      "$ref": "#/$defs/airbrush"
    },
    {
      "$ref": "#/$defs/preset"
    }
  ],
  "$defs": {
    "airbrush": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "enabled",
        "intervalMs"
      ],
      "properties": {
        "model": {
          "const": "time-interval-v1"
        },
        "enabled": {
          "type": "boolean"
        },
        "intervalMs": {
          "type": "number",
          "minimum": 1,
          "maximum": 1000
        }
      }
    },
    "preset": {
      "type": "object",
      "required": [
        "parameters"
      ],
      "properties": {
        "parameters": {
          "type": "object",
          "required": [
            "airbrush"
          ],
          "properties": {
            "airbrush": {
              "$ref": "#/$defs/airbrush"
            }
          }
        }
      }
    }
  }
}
